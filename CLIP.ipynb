      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Computing normalized average style deltas...\n",
            "Computed normalized average style deltas for 29 packs.\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# --- UMAP visualization of selected packs: per-texture deltas + avg (normalized) ---\n",
        "from umap.umap_ import UMAP\n",
        "import numpy as np\n",
        "from matplotlib import cm\n",
        "import umap\n",
        "\n",
        "# ===== choose which packs to visualize =====\n",
        "packs_to_plot = [\n",
        "    \"faithful-32x\",\n",
        "    \"plastic-texture-pack\",\n",
        "    \"ashen\"\n",
        "]\n",
        "\n",
        "# ===== gather delta vectors from style_delta =====\n",
        "all_vecs, all_labels, all_names = [], [], []\n",
        "for pack_id in packs_to_plot:\n",
        "    rows = style_delta.get(pack_id)  # dict[name] -> delta tensor\n",
        "    if not rows:\n",
        "        print(f\"Skipping {pack_id} (not in style_delta or empty)\")\n",
        "        continue\n",
        "    for name, v in rows.items():\n",
        "        if isinstance(v, torch.Tensor):\n",
        "            v = v.detach().cpu().numpy()\n",
        "        all_vecs.append(v)\n",
        "        all_labels.append(pack_id)\n",
        "        all_names.append(name)\n",
        "\n",
        "if not all_vecs:\n",
        "    raise RuntimeError(\"No vectors collected—check packs_to_plot and style_delta.\")\n",
        "\n",
        "all_vecs = np.stack(all_vecs)\n",
        "all_labels = np.array(all_labels)\n",
        "all_names  = np.array(all_names)\n",
        "print(f\"Using {len(all_vecs)} vectors across {len(set(all_labels))} packs.\")\n",
        "\n",
        "# ===== run UMAP =====\n",
        "reducer = umap.UMAP(\n",
        "    n_components=2,\n",
        "    random_state=42,\n",
        "    n_neighbors=15,\n",
        "    min_dist=0.10,\n",
        "    verbose=True,\n",
        ")\n",
        "emb = reducer.fit_transform(all_vecs)  # [N, 2]\n",
        "\n",
        "# ===== Outlier clipping =====\n",
        "def clip_2d_outliers(emb, labels, names, z_thresh=3.0, min_points=10):\n",
        "    \"\"\"\n",
        "    Removes UMAP 2D outliers per-pack and RETURNS the number of removed points.\n",
        "    \"\"\"\n",
        "    emb = np.asarray(emb)\n",
        "    labels = np.asarray(labels)\n",
        "    names = np.asarray(names)\n",
        "\n",
        "    keep         = np.ones(len(emb), dtype=bool)\n",
        "    total_removed = 0\n",
        "\n",
        "    uniq = np.unique(labels)\n",
        "    for p in uniq:\n",
        "        mask = (labels == p)\n",
        "        idx = np.where(mask)[0]\n",
        "        pts = emb[mask]\n",
        "\n",
        "        if pts.shape[0] < min_points:\n",
        "            continue\n",
        "\n",
        "        center = np.median(pts, axis=0)\n",
        "        dists  = np.linalg.norm(pts - center[None, :], axis=1)\n",
        "        med    = np.median(dists)\n",
        "        mad    = np.median(np.abs(dists - med)) + 1e-6\n",
        "\n",
        "        z = np.abs(dists - med) / mad\n",
        "        local_keep = z <= z_thresh\n",
        "        removed = np.sum(~local_keep)\n",
        "        total_removed += removed\n",
        "\n",
        "        if removed > 0:\n",
        "            print(f\"\\nOutliers for pack '{p}' (z>{z_thresh}):\")\n",
        "            for local_i in np.where(~local_keep)[0]:\n",
        "                global_i = idx[local_i]\n",
        "                x, y = emb[global_i]\n",
        "                print(\n",
        "                    f\"  texture='{names[global_i]}', \"\n",
        "                    f\"coord=({x:.3f}, {y:.3f}), z={z[local_i]:.2f}\"\n",
        "                )\n",
        "\n",
        "        keep[idx] = local_keep\n",
        "\n",
        "    # return clipped arrays AND the number removed\n",
        "    return emb[keep], labels[keep], names[keep], total_removed\n",
        "\n",
        "Z_THRESH_2D = 3.0\n",
        "emb, all_labels, all_names, removed_count = clip_2d_outliers(\n",
        "    emb, all_labels, all_names, z_thresh=Z_THRESH_2D\n",
        ")\n",
        "\n",
        "print(f\"\\nTotal points clipped: {removed_count}\")\n",
        "print(f\"Points remaining:     {len(emb)}\\n\")\n",
        "\n",
        "# ===== project avg vectors =====\n",
        "uniq_packs = [p for p in packs_to_plot if p in set(all_labels)]\n",
        "avg_vecs, avg_labels = [], []\n",
        "for p in uniq_packs:\n",
        "    v = norm_avg_style_delta.get(p)\n",
        "    if v is None:\n",
        "        print(f\"Warning: no normalized average for {p}; skipping avg marker\")\n",
        "        continue\n",
        "    if isinstance(v, torch.Tensor):\n",
        "        v = v.detach().cpu().numpy()\n",
        "    avg_vecs.append(v)\n",
        "    avg_labels.append(p)\n",
        "\n",
        "emb_avgs = reducer.transform(np.stack(avg_vecs)) if avg_vecs else np.empty((0, 2))\n",
        "\n",
        "# ===== Plot =====\n",
        "colors = cm.tab10(np.linspace(0, 1, len(uniq_packs)))\n",
        "pack_color = {p: colors[i] for i, p in enumerate(uniq_packs)}\n",
        "\n",
        "plt.figure(figsize=(10, 7))\n",
        "\n",
        "for p in uniq_packs:\n",
        "    mask = (all_labels == p)\n",
        "    plt.scatter(\n",
        "        emb[mask, 0], emb[mask, 1],\n",
        "        s=10, alpha=0.7, lw=0,\n",
        "        color=pack_color[p],\n",
        "        label=f\"{p} (not normalized)\"\n",
        "    )\n",
        "\n",
        "for i, p in enumerate(avg_labels):\n",
        "    x, y = emb_avgs[i]\n",
        "    plt.scatter(\n",
        "        x, y,\n",
        "        color=pack_color[p],\n",
        "        marker='X',\n",
        "        s=70,\n",
        "        linewidth=1.2,\n",
        "        edgecolor='black',\n",
        "        zorder=10,\n",
        "        label=f\"{p} (avg, normalized)\"\n",
        "    )\n",
        "\n",
        "plt.title(\"2D UMAP Projection of Style Delta Vectors (with outlier clipping)\")\n",
        "plt.xlabel(\"UMAP Dimension 1\")\n",
        "plt.ylabel(\"UMAP Dimension 2\")\n",
        "plt.legend(markerscale=1.0, fontsize=8, frameon=True)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
